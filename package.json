    "n3",
    "bgp",
    "basic graph pattern",
    "sparql",
    "bindings"
  ],
  "license": "MIT",
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/n3-match-bgp.git"
  },
  "bugs": "https://github.com/jeswr/n3-match-bgp/issues",
  "homepage": "https://github.com/jeswr/n3-match-bgp#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "src",
    "index.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
